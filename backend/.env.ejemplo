# Variables de entorno.
#  - Cloudflare (variante principal): DB_DRIVER y PBKDF2_ITER van en "vars" de
#    wrangler.jsonc; SECRETO_SESION se registra con  npx wrangler secret put SECRETO_SESION
#    D1 y R2 se conectan por bindings: NO hay llaves de base de datos.
#  - Servidor Node (infraestructura propia): copiar este archivo como .env

# Cadena aleatoria de al menos 32 caracteres. Firma las sesiones: si cambia, todos
# vuelven a iniciar sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_SESION=

# "d1"        = Cloudflare D1 + R2 (solo dentro de Workers)
# "postgrest" = Supabase o PostgreSQL con PostgREST
# "archivo"   = JSON local (SOLO demo/pruebas; un proceso, sin respaldos)
DB_DRIVER=postgrest

# Solo driver postgrest
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=

# Iteraciones PBKDF2 para contraseñas nuevas (default 100000). Cada usuario guarda
# las suyas, así que cambiar este valor no invalida cuentas existentes.
PBKDF2_ITER=100000

# Solo servidor Node
PUERTO=8080
